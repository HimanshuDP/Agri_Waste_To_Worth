# ==============================================================================
# AgriWaste to Worth - Production Environment Configuration
# Copy this file to .env on your production server or configure in your cloud host
# ==============================================================================

# Server Environment
FLASK_ENV=production
PORT=5000
SECRET_KEY=generate-a-strong-random-hex-string-for-session-signing

# Database (Leave empty for built-in persistent SQLite, or supply PostgreSQL URL)
# DATABASE_URL=postgresql://user:password@host:5432/agriwaste

# AI & LLM Inference Keys
GROQ_API_KEY=your_production_groq_api_key_here

# Payment Gateway (Razorpay Escrow)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Logistics & Mapping
GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

